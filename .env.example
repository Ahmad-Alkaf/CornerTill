APP_DEBUG=true
APP_ENV=local
APP_KEY=
APP_NAME="CornerTill"
# Production: https://cornertill.com
APP_URL="http://localhost:8000"

AWS_ACCESS_KEY_ID=
AWS_BUCKET=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_URL="https://example-bucket.s3.amazonaws.com/"

# Free beta limits for every business (used when PAYMENTS_ENABLED=false).
BETA_MAX_ACCOUNTS=2
BETA_MAX_PRODUCTS=500
BETA_MAX_BILLS_PER_MONTH=15000

DB_CONNECTION=mysql
DB_DATABASE=cornertill
DB_HOST=
DB_PASSWORD=
DB_PORT=3306
DB_USERNAME=root
# Seconds before a MySQL connection attempt fails.
DB_CONNECT_TIMEOUT=5
# Seconds for the database check of /api/health (connect and read).
DB_HEALTH_TIMEOUT=2

FILESYSTEM_DISK=local

# Social login switches. A disabled provider hides its button and its
# /auth/{provider}/* routes return 404.
SOCIAL_GOOGLE_ENABLED=true
SOCIAL_GITHUB_ENABLED=true
SOCIAL_X_ENABLED=false

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

X_CLIENT_ID=
X_CLIENT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@kaflabs.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_HOST=
MAIL_MAILER=smtp
MAIL_PASSWORD=
MAIL_PORT=587
MAIL_USERNAME=

# Receiver of the daily database table counts email. Empty = no email.
ADMIN_REPORT_EMAIL=

# false (default) = free beta: Paddle plans, pricing, subscription routes,
# the Paddle webhook, and Paddle.js are off. true = Paddle subscriptions.
# Before true: update the legal pages first (README.md "Launch switches").
PAYMENTS_ENABLED=false

PADDLE_SELLER_ID=
PADDLE_AUTH_CODE=
PADDLE_WEBHOOK_SECRET="pdl_xxxx"
PADDLE_SANDBOX=true
PADDLE_PRODUCT_ID_BASIC=
PADDLE_PRODUCT_ID_ENHANCED=
PADDLE_PRODUCT_ID_ADVANCED=
PADDLE_PRICE_ID_BASIC_MONTHLY=
PADDLE_PRICE_ID_BASIC_ANNUALLY=
PADDLE_PRICE_ID_ENHANCED_MONTHLY=
PADDLE_PRICE_ID_ENHANCED_ANNUALLY=
PADDLE_PRICE_ID_ADVANCED_MONTHLY=
PADDLE_PRICE_ID_ADVANCED_ANNUALLY=

# Queued emails. The Docker image uses `database` and runs a queue worker.
QUEUE_CONNECTION=sync
